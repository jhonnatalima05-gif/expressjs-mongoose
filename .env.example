# --- Já existentes ---
MONGO_URL=
META_PIXEL_ID=
META_ACCESS_TOKEN=          # token com permissão ads_management + ads_read

# --- JARVIS: obrigatório ---
ANTHROPIC_API_KEY=
JARVIS_API_TOKEN=           # senha das rotas /jarvis (header x-jarvis-token)

# --- JARVIS: integrações ---
META_AD_ACCOUNT_ID=         # só os números, sem "act_"
TELEGRAM_BOT_TOKEN=         # crie com o @BotFather
TELEGRAM_CHAT_ID=           # descubra com o @userinfobot
RESEND_API_KEY=             # envio de e-mails para clientes
JARVIS_EMAIL_FROM=          # ex.: Suporte <suporte@seudominio.com.br>

# --- Recuperação de PIX / vendas no WhatsApp (WhatsApp Cloud API oficial) ---
WHATSAPP_TOKEN=                       # token permanente do app na Meta
WHATSAPP_PHONE_NUMBER_ID=             # ID do número no WhatsApp Manager
WHATSAPP_VERIFY_TOKEN=                # qualquer senha; a mesma vai no painel da Meta
META_APP_SECRET=                      # valida a assinatura do webhook
WHATSAPP_TEMPLATES_RECUPERACAO=recuperacao_pix_1,recuperacao_pix_2
JARVIS_RECUPERACAO=true
JARVIS_RECUPERACAO_MINUTOS=15,240     # 1º contato 15 min após o PIX, 2º após 4h
JARVIS_CONTATO_HORA_INICIO=8
JARVIS_CONTATO_HORA_FIM=21
JARVIS_FOLLOWUP_SILENCIO_MIN=180
JARVIS_RECUPERACAO_DIAS=3

# --- Mineração de ofertas (Biblioteca de Anúncios) ---
APIFY_TOKEN=                          # fonte principal para anúncios do Brasil (apify.com)
APIFY_ADS_ACTOR=curious_coder~facebook-ads-library-scraper
JARVIS_MINERACAO_DIA=1                # 0=domingo ... 6=sábado; -1 desliga a mineração semanal
JARVIS_MINERACAO_HORA=7
JARVIS_DIAS_PARA_CRIAR_OFERTA=30

# --- Voz (opcional; sem isto a central usa a voz do próprio aparelho) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=                  # escolha uma voz masculina, calma, estilo mordomo britânico
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- JARVIS: comportamento ---
JARVIS_AUTONOMIA=supervisionada      # supervisionada | total
JARVIS_MAX_ORCAMENTO_DIARIO=300
JARVIS_MAX_VARIACAO_ORCAMENTO_PCT=20
JARVIS_MAX_REEMBOLSO_AUTOMATICO=0
JARVIS_ROAS_MINIMO=1.5
JARVIS_GASTO_MINIMO_PARA_JULGAR=50
JARVIS_HORAS_SEM_VENDA_ALERTA=4
JARVIS_HORAS_TICKET_PENDENTE_ALERTA=6
JARVIS_MONITOR_INTERVALO_MIN=15
JARVIS_AUTO_ACAO=true
JARVIS_AUTO_SUPORTE=true
JARVIS_RELATORIO_HORA=8
JARVIS_TIMEZONE=America/Sao_Paulo
# JARVIS_MODEL=claude-opus-5-5
# JARVIS_WORKER_MODEL=claude-opus-5-5
